# Copy to .env.local and adjust.

# Developer-only Demo Preview Mode. Loads clearly labelled demo sessions for
# /buyer, /seller and /admin so the dashboards can be presented before the
# backend exists. Never enable this in production.
VITE_DEMO_MODE=true

# Reserved for the future Supabase integration (not implemented in this phase).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
