# Copy to .env.local and fill in. .env.local is gitignored.

# Developer-only Demo Preview Mode: labelled in-memory demo data for every dashboard.
# true  → demo data (no backend used)
# false → live Supabase backend (needs the two VITE_SUPABASE_* values below)
# Never enable this in production.
VITE_DEMO_MODE=false

# Public browser values (Supabase dashboard → Project Settings → API).
# Use the publishable/anon key only — never the service_role or secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only, used by `node scripts/db-push.mjs` to apply migrations.
# Never prefix these with VITE_ — they must not reach the browser.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
